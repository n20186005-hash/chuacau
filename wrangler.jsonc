{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chuacau",
  "compatibility_date": "2026-08-01",
  "main": "./src/worker.js",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
