---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import { t, localizedPath } from '../i18n';
import type { Locale, RouteKey } from '../i18n';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  description: string;
}
const { locale, routeKey, title, description } = Astro.props;
const failure = { vi:'Không xác nhận được lựa chọn đã lưu. Phân tích đang tắt trong trang này; trình duyệt hoặc tab khác có thể còn lựa chọn cũ.', en:'The saved choice could not be confirmed. Analytics is off in this page; another tab or stored choice may still differ.', zh:'無法確認已儲存選擇。本頁分析已關閉；其他分頁或原有儲存選擇可能仍不同。' }[locale];
---
<Base locale={locale} routeKey={routeKey} title={title} description={description}>
  <SiteHeader locale={locale} routeKey={routeKey} solid />
  <main class="shell max-w-4xl py-16" id="cookie-settings" data-saved={t('cookieSaved', locale)} data-rejected={t('cookieRejected', locale)} data-failure={failure}>
    <p class="sans text-sm">{t('cookieUpdated', locale)}</p>
    <h1 class="section-title">{t('cookieH2', locale)}</h1>
    <p class="mt-5 leading-8">{t('cookieLead', locale)}</p>
    <div class="card mt-8 p-7 sans">
      <div class="cookie-row">
        <div><strong>{t('cookieEssential', locale)}</strong><p class="text-sm">{t('cookieEssentialDesc', locale)}</p></div>
        <span>{t('cookieAlwaysOn', locale)}</span>
      </div>
      <div class="cookie-row">
        <div><strong>{t('cookieAnalytics', locale)}</strong><p class="text-sm">{t('cookieAnalyticsDesc', locale)}</p></div>
        <label><input id="analytics" type="checkbox" /> {t('cookieActivate', locale)}</label>
      </div>
      <div class="cookie-row">
        <div><strong>{t('cookiePrefs', locale)}</strong><p class="text-sm">{t('cookiePrefsDesc', locale)}</p></div>
        <span>{t('cookieOff', locale)}</span>
      </div>
      <div class="cookie-row">
        <div><strong>{t('cookieMarketing', locale)}</strong><p class="text-sm">{t('cookieMarketingDesc', locale)}</p></div>
        <span>{t('cookieOff', locale)}</span>
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <button id="save" class="btn btn-primary">{t('cookieSave', locale)}</button>
        <button id="reject" class="btn border border-[#9d3b2f]">{t('cookieReject', locale)}</button>
      </div>
      <p id="status" class="mt-4 text-sm" aria-live="polite"></p>
    </div>
    <p class="mt-5"><a class="underline" href={localizedPath('privacy', locale)}>{t('footerPrivacy', locale)}</a></p>
    <script is:inline src="/cookie-settings.js"></script>
  </main>
  <Footer locale={locale} routeKey={routeKey} />
</Base>
