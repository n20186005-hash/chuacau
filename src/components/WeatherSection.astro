---
import { getWeather, buildAdvice, wmo, beaufort, uvLabel } from '../lib/weather';
import { t } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'vi' } = Astro.props;

let data: Awaited<ReturnType<typeof getWeather>> | null = null;
let failed = false;
try {
  data = await getWeather();
} catch {
  failed = true;
}

const INTL_LOCALE: Record<Locale, string> = { vi: 'vi-VN', en: 'en-GB', zh: 'zh-Hant-TW' };
const weekdays: Record<Locale, string[]> = {
  vi: ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'],
  en: ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'],
  zh: ['日', '一', '二', '三', '四', '五', '六'],
};
function dayLabel(d: string): string {
  const dt = new Date(d + 'T00:00:00');
  return weekdays[locale][dt.getDay()];
}
function dayName(d: string): string {
  const dt = new Date(d + 'T00:00:00');
  return dt.toLocaleDateString(INTL_LOCALE[locale], { day: '2-digit', month: '2-digit', timeZone: 'Asia/Ho_Chi_Minh' });
}

const advice = data ? buildAdvice(data, locale) : null;
const nowInfo = data ? wmo(data.now.code, locale) : null;
const wind = data ? beaufort(data.now.windKmh, locale) : null;
---

<section id="thoi-tiet" class="py-20">
  <div class="shell">
    <span class="tag sans text-xs">{t('weatherTag', locale)}</span>
    <h2 class="section-title mt-5">{t('weatherH2', locale)}</h2>
    <p class="mt-5 max-w-3xl leading-8">{t('weatherLead', locale)}</p>

    {failed && (
      <div class="card mt-10 p-7 text-center leading-7">{t('weatherFailed', locale)}</div>
    )}

    {data && nowInfo && wind && (
      <div class="mt-10 grid gap-6 lg:grid-cols-[1.1fr_1fr]">
        <!-- Hiện tại -->
        <div class="card p-7">
          <div class="flex items-center justify-between">
            <div>
              <p class="sans text-xs tracking-[.18em] uppercase text-[#9d3b2f]">{t('weatherNow', locale)}</p>
              <p class="mt-1 text-6xl font-bold leading-none">{data.now.temperature}°C</p>
              <p class="mt-2 text-sm text-[#1e4051]">{nowInfo.icon} {nowInfo.text}</p>
            </div>
            <div class="text-7xl" aria-hidden="true">{nowInfo.icon}</div>
          </div>
          <dl class="mt-6 grid grid-cols-2 gap-4 text-sm">
            <div><dt class="text-[#9d3b2f]">{t('weatherFeels', locale)}</dt><dd class="text-lg font-semibold">{data.now.apparent}°C</dd></div>
            <div><dt class="text-[#9d3b2f]">{t('weatherHumidity', locale)}</dt><dd class="text-lg font-semibold">{data.now.humidity}%</dd></div>
            <div><dt class="text-[#9d3b2f]">{t('weatherWind', locale)}</dt><dd class="text-lg font-semibold">Cấp {wind.level} · {wind.label} ({Math.round(data.now.windKmh)} km/h)</dd></div>
            <div><dt class="text-[#9d3b2f]">{t('weatherPrecip', locale)}</dt><dd class="text-lg font-semibold">{data.days[0].precipProb}%</dd></div>
          </dl>
          <p class="mt-4 text-sm text-[#1e4051]">{t('weatherUv', locale)}: <strong>{uvLabel(data.days[0].uvMax, locale)}</strong> ({data.days[0].uvMax})</p>
        </div>

        <!-- 7 ngày tới -->
        <div class="card p-7">
          <p class="sans text-xs tracking-[.18em] uppercase text-[#9d3b2f]">{t('weatherDays7', locale)}</p>
          <ul class="mt-4 divide-y divide-[rgba(98,69,37,.15)]">
            {data.days.map((d) => (
              <li class="flex items-center justify-between py-3">
                <span class="w-16 text-sm font-semibold">{dayLabel(d.date)}</span>
                <span class="w-14 text-center text-xl" aria-hidden="true">{wmo(d.code, locale).icon}</span>
                <span class="flex-1 px-2 text-sm">{wmo(d.code, locale).text}</span>
                <span class="text-sm font-semibold">{d.tMin}° / {d.tMax}°</span>
                <span class="w-12 text-right text-xs text-[#1e4051]">{d.precipProb}%</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}

    {advice && (
      <div class="mt-8 space-y-4">
        {advice.alerts.map((a) => (
          <div class="card border-l-4 border-[#9d3b2f] bg-[#fbeae6] p-6">
            <p class="sans text-xs font-bold tracking-[.14em] uppercase text-[#9d3b2f]">{t('weatherAlert', locale)}</p>
            <p class="mt-2 leading-7" set:html={a}></p>
          </div>
        ))}
        <div class="grid gap-4 md:grid-cols-3">
          {advice.outfit.length > 0 && (
            <div class="card p-6">
              <p class="sans text-xs font-bold tracking-[.14em] uppercase text-[#1e4051]">{t('weatherOutfit', locale)}</p>
              <ul class="mt-2 list-disc space-y-1 pl-5 leading-7">{advice.outfit.map((o) => <li set:html={o}></li>)}</ul>
            </div>
          )}
          {advice.plan.length > 0 && (
            <div class="card p-6">
              <p class="sans text-xs font-bold tracking-[.14em] uppercase text-[#1e4051]">{t('weatherPlan', locale)}</p>
              <ul class="mt-2 list-disc space-y-1 pl-5 leading-7">{advice.plan.map((p) => <li set:html={p}></li>)}</ul>
            </div>
          )}
          {advice.items.length > 0 && (
            <div class="card p-6">
              <p class="sans text-xs font-bold tracking-[.14em] uppercase text-[#1e4051]">{t('weatherItems', locale)}</p>
              <div class="mt-3 flex flex-wrap gap-2 sans text-sm">
                {advice.items.map((it) => <span class="tag" set:html={it}></span>)}
              </div>
            </div>
          )}
        </div>
      </div>
    )}
  </div>
</section>
