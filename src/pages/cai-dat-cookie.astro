---
import Base from '../layouts/Base.astro'; import Logo from '../components/Logo.astro'; import Footer from '../components/Footer.astro';
---
<Base title="Cài đặt Cookie | Chùa Cầu Hội An" description="Quản lý lựa chọn Cookie cho trang Chùa Cầu Hội An."><header class="bg-[#2a2118] text-white"><div class="shell py-6"><Logo/></div></header><main class="shell max-w-4xl py-16"><p class="sans text-sm">Cập nhật: tháng 9 năm 2026</p><h1 class="section-title">Cài đặt Cookie</h1><p class="mt-5 leading-8">Bạn có thể quản lý lựa chọn bên dưới. Cookie cần thiết luôn hoạt động vì chúng phục vụ chức năng cơ bản và lưu lựa chọn đồng ý của chính bạn.</p><div class="card mt-8 p-7 sans"><div class="cookie-row"><div><strong>Cookie cần thiết</strong><p class="text-sm">Cần để trang hoạt động và lưu lựa chọn quyền riêng tư.</p></div><span>Luôn hoạt động</span></div><div class="cookie-row"><div><strong>Cookie phân tích</strong><p class="text-sm">Google Analytics 4 – G-HXM22WWPKP, chỉ tải khi bạn đồng ý.</p></div><label><input id="analytics" type="checkbox"/> Kích hoạt</label></div><div class="cookie-row"><div><strong>Cookie tùy chọn</strong><p class="text-sm">Có thể dùng để ghi nhớ một số thiết lập giao diện trong tương lai.</p></div><label><input id="prefs" type="checkbox"/> Kích hoạt</label></div><div class="cookie-row"><div><strong>Cookie tiếp thị</strong><p class="text-sm">Trang hiện không triển khai quảng cáo cá nhân hóa.</p></div><span>Tắt</span></div><div class="mt-6 flex flex-wrap gap-3"><button id="save" class="btn btn-primary">Lưu lựa chọn</button><button id="reject" class="btn border border-[#9d3b2f]">Từ chối tùy chọn</button></div><p id="status" class="mt-4 text-sm" aria-live="polite"></p></div><script is:inline>{`const a=document.getElementById('analytics'),p=document.getElementById('prefs'),s=document.getElementById('status');a.checked=localStorage.getItem('analytics-consent')==='granted';p.checked=localStorage.getItem('prefs-consent')==='granted';document.getElementById('save').onclick=()=>{localStorage.setItem('analytics-consent',a.checked?'granted':'denied');localStorage.setItem('prefs-consent',p.checked?'granted':'denied');s.textContent='Đã lưu lựa chọn. Tải lại trang để áp dụng thay đổi phân tích.'};document.getElementById('reject').onclick=()=>{a.checked=false;p.checked=false;localStorage.setItem('analytics-consent','denied');localStorage.setItem('prefs-consent','denied');s.textContent='Đã tắt Cookie tùy chọn.'};`}</script></main><Footer/></Base>
