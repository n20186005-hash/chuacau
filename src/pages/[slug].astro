---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import GuideContent from '../components/GuideContent.astro';
import Footer from '../components/Footer.astro';
import { guides } from '../content/guides';

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const siteUrl = Astro.site?.toString() ?? '';
const canonicalPath = `/${guide.slug}/`;
const canonicalUrl = siteUrl ? new URL(canonicalPath, siteUrl).href : canonicalPath;
const archiveUrl = siteUrl ? new URL('/cam-nang-chua-cau/', siteUrl).href : '/cam-nang-chua-cau/';
const websiteId = siteUrl ? `${siteUrl.replace(/\/$/, '')}#website` : '#website';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebPage',
        '@id': `${canonicalUrl}#webpage`,
        url: canonicalUrl,
        name: guide.title,
        description: guide.description,
        inLanguage: 'vi',
        dateModified: guide.updated,
        isPartOf: { '@id': websiteId },
      },
      {
        '@type': 'Article',
        '@id': `${canonicalUrl}#article`,
        headline: guide.title,
        description: guide.description,
        dateModified: guide.updated,
        mainEntityOfPage: { '@id': `${canonicalUrl}#webpage` },
        about: { '@type': 'TouristAttraction', name: 'Chùa Cầu Hội An' },
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Chùa Cầu', item: siteUrl || '/' },
          { '@type': 'ListItem', position: 2, name: 'Cẩm nang Chùa Cầu', item: archiveUrl },
          { '@type': 'ListItem', position: 3, name: guide.title, item: canonicalUrl },
        ],
      },
      ...(guide.faqs.length > 0
        ? [{
            '@type': 'FAQPage',
            '@id': `${canonicalUrl}#faq`,
            mainEntity: guide.faqs.map(([question, answer]) => ({
              '@type': 'Question',
              name: question,
              acceptedAnswer: {
                '@type': 'Answer',
                text: answer,
              },
            })),
          }]
        : []),
    ],
  },
];
---
<Base
  locale="vi"
  title={guide.seoTitle}
  description={guide.description}
  canonicalPath={canonicalPath}
  alternates={[]}
  jsonLd={jsonLd}
>
  <SiteHeader locale="vi" solid languageLinks={[]} />
  <GuideContent guide={guide} />
  <Footer locale="vi" routeKey="home" />
</Base>
